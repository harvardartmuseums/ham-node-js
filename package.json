{
  "name": "@harvardartmuseums/ham",
  "version": "2.0.0",
  "description": "A Node.js library for the Harvard Art Museums API.",
  "homepage": "https://hvrd.art/api",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/harvardartmuseums/ham-node-js.git"
  },
  "scripts": {
    "check:types": "tsc --noEmit --strict index.d.ts"
  },
  "keywords": [
    "HAM",
    "harvard art museums",
    "api",
    "museum",
    "collection",
    "art",
    "iiif"
  ],
  "author": "HAM DIET",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/harvardartmuseums/ham-node-js/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
